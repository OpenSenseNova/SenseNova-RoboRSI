#!/bin/sh
# Keep the graphics dispatch libraries consistent for the isolated Habitat runtime.
set -eu
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libGLdispatch.so.0:/usr/lib/x86_64-linux-gnu/libEGL.so.1:/usr/lib/x86_64-linux-gnu/libGLX.so.0:/usr/lib/x86_64-linux-gnu/libOpenGL.so.0
exec "$(dirname "$0")/python" "$@"
